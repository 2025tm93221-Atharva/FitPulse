# Copied to ci/.env (gitignored) by ci/setup.sh, which fills in the admin password.
JENKINS_ADMIN_PASSWORD=
GIT_URL=https://github.com/2025tm93221-Atharva/FitPulse.git
GIT_BRANCH=main
# none | rolling | blue-green | canary | shadow | ab-testing | all
DEPLOY_STRATEGY=all
# http://sonarqube:9000 once SonarQube runs and SONAR_TOKEN holds a project analysis token.
SONAR_HOST_URL=
SONAR_TOKEN=
# Docker Hub username and access token; leave empty to load images straight into Minikube.
DOCKERHUB_USER=
DOCKERHUB_TOKEN=
